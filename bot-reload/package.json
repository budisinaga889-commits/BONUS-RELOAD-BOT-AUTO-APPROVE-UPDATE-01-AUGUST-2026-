{
  "name": "bonus-reload-bot",
  "productName": "Bonus Reload Bot",
  "version": "1.0.0",
  "description": "Production-grade deposit approval bot for Bonus Reload transactions. Electron + Playwright + SQLite.",
  "main": "dist/main/main.js",
  "author": "Bonus Reload Bot Team",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "clean": "rimraf dist",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node scripts/copy-renderer.js",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "npm rebuild better-sqlite3 --build-from-source",
    "postinstall": "node scripts/postinstall.js",
    "start": "npm run build && electron dist/main/main.js",
    "dev": "npm run build && electron dist/main/main.js",
    "pretest": "node scripts/rebuild-for-node.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "tsc --noEmit -p tsconfig.main.json",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.13",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.16.0",
    "electron": "^32.1.0",
    "electron-builder": "^25.0.5",
    "jest": "^29.7.0",
    "jsdom": "^22.1.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.2"
  },
  "build": {
    "appId": "com.emergent.bonusreloadbot",
    "productName": "Bonus Reload Bot",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config",
        "to": "config"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}",
      "unpackDirName": "bonus-reload-bot-${version}",
      "requestExecutionLevel": "user"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  }
}
